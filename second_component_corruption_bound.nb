Clear["Global`*"]

muSquared[eps_, sig_] := (3*eps*(20*eps*sig^2 - 4*eps - 15*sig^2 + 15)) / 
                         (5*(17*eps^2 - 45*eps + 27));

lhs[eps_] := eps/(1 - eps);
rhs[eps_, sig_] := 5*muSquared[eps, sig];

(* 2. Define the exact range assumptions *)
assumptions = 0 <= eps <= 0.5 && 0 <= sig <= Sqrt[0.1];

(* 3. Check if the inequality holds for ALL values in that range *)
(* This returns True if it always holds, and False if it fails anywhere *)
isAlwaysTrue = Resolve[
  ForAll[{eps, sig}, assumptions, lhs[eps] <= rhs[eps, sig]]
]
